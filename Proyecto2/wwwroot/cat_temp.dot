   cat_JUANCA -> cat_EDDY;
   cat_EDDY [label="EDDY"];
   cat_MARLON -> cat_PALOMO;
   cat_PALOMO [label="PALOMO"];
   cat_NoExiste [label="NoExiste"];
   cat_NoExiste -> cat_Huerfana;
   cat_Huerfana [label="Huerfana"];
   cat_Tecnologia [label="Tecnologia"];
