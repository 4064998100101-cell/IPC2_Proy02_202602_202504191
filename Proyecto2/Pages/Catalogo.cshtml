@page
@model Proyecto2.Pages.CatalogoModel
@{
    ViewData["Title"] = "Gestión de Catálogo - USAC";
}

<div class="container mt-4">
    <div class="p-4 mb-4 bg-light rounded-3 shadow-sm">
        <h1 class="display-6 fw-bold">Sistema Inteligente de Librería - USAC</h1>
        <p class="col-md-8 fs-6 text-muted">Gestión avanzada de Estructuras de Datos No Lineales y Reportes Graphviz.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Pestañas Principales -->
    <ul class="nav nav-tabs" id="catalogTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="xml-tab" data-bs-toggle="tab" data-bs-target="#xmlSection" type="button" role="tab">1. Cargar XML</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="cat-tab" data-bs-toggle="tab" data-bs-target="#catSection" type="button" role="tab">2. Categorías y Árboles AVL</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="lib-tab" data-bs-toggle="tab" data-bs-target="#libSection" type="button" role="tab">3. Gestión y Libros</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="report-tab" data-bs-toggle="tab" data-bs-target="#reportSection" type="button" role="tab">4. Reportes Gráficos</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="help-tab" data-bs-toggle="tab" data-bs-target="#helpSection" type="button" role="tab">5. Ayuda</button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-4 bg-white shadow-sm rounded-bottom mb-5" id="catalogTabsContent">
        
        <!-- SECCIÓN 1: CARGA DE XML -->
        <div class="tab-pane fade show active" id="xmlSection" role="tabpanel">
            <h3 class="mb-3">Carga de Archivo XML</h3>
            <p class="text-muted">Cargue la configuración inicial o aplique cargas incrementales de archivos XML.</p>
            <form method="post" enctype="multipart/form-data" asp-page-handler="CargarXml" class="mt-3">
                <div class="input-group mb-3">
                    <input type="file" class="form-control" name="ArchivoXml" accept=".xml" required />
                    <button type="submit" class="btn btn-primary px-4">Procesar Archivo XML</button>
                </div>
            </form>
        </div>

        <!-- SECCIÓN 2: CATEGORÍAS Y ÁRBOLES AVL -->
        <div class="tab-pane fade" id="catSection" role="tabpanel">
            <h3 class="mb-3">Crear Categoría / Subcategoría</h3>
            <form method="post" asp-page-handler="AgregarCategoria" class="row g-3 mb-4 p-3 border rounded bg-light">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Nombre</label>
                    <input type="text" class="form-control" name="NuevaCategoria" placeholder="Ej. Literatura" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Categoría Padre (Opcional)</label>
                    <input type="text" class="form-control" name="CategoriaPadre" placeholder="Dejar en blanco si es principal" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Crear</button>
                </div>
            </form>

            <hr class="my-4" />

            <h3 class="mb-3">Consultar Categoría y Árbol AVL de Libros</h3>
            <form method="get" class="row g-3 mb-4">
                <div class="col-md-9">
                    <input type="text" class="form-control" name="CategoriaSeleccionada" value="@Model.CategoriaSeleccionada" placeholder="Nombre exacto de la categoría" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-dark w-100">Consultar y Graficar</button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.LibrosOrdenadosHtml))
            {
                <div class="card p-3 bg-light mb-4 border-0 shadow-sm">
                    <h5 class="text-primary fw-bold">Libros en Orden Ascendente (In-Order por ISBN)</h5>
                    <div class="p-2 bg-white border rounded">
                        @Html.Raw(Model.LibrosOrdenadosHtml)
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.RutaImagenAvl))
            {
                <div class="text-center p-3 border bg-light rounded mt-3">
                    <h5 class="text-secondary">Árbol AVL Balanceado</h5>
                    <div class="overflow-auto bg-white p-2 border rounded">
                        <img src="@Model.RutaImagenAvl" class="img-fluid" alt="Gráfico Árbol AVL" />
                    </div>
                </div>
            }
        </div>


<!-- SECCIÓN 3: GESTIÓN DE LIBROS (REGISTRO Y ELIMINACIÓN) -->
<div class="tab-pane fade" id="libSection" role="tabpanel">
    <div class="row">
        <!-- Registro -->
        <div class="col-md-6 border-end pe-4">
            <h3 class="mb-3">Registrar Libro</h3>
            <form method="post" asp-page-handler="RegistrarLibro">
                <div class="mb-3">
                    <label class="form-label fw-semibold">ISBN (Sin límite de dígitos)</label>
                    <input type="number" class="form-control" name="Isbn" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Título</label>
                    <input type="text" class="form-control" name="Titulo" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Autor</label>
                    <input type="text" class="form-control" name="Autor" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Categoría</label>
                    <input type="text" class="form-control" name="CategoriaNombre" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Registrar</button>
            </form>
        </div>
        <!-- Resto del código... -->

                <!-- Eliminación y Consultas Globales (Árbol Binario) -->
                <div class="col-md-6 ps-4">
                    <h3 class="mb-3">Eliminar Libro No Disponible</h3>
                    <form method="post" asp-page-handler="EliminarLibro" class="mb-4 p-3 border rounded bg-light">
                        <div class="mb-2">
                            <label class="form-label fw-semibold">ISBN a Eliminar</label>
                            <input type="number" class="form-control" name="IsbnAEliminar" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Categoría del Libro</label>
                            <input type="text" class="form-control" name="CategoriaParaEliminar" required />
                        </div>
                        <button type="submit" class="btn btn-danger w-100">Eliminar Libro</button>
                    </form>

                    <h3 class="mb-3">Búsqueda y Rangos Globales</h3>
                    <form method="post" asp-page-handler="BuscarIsbn" class="mb-3">
                        <div class="input-group">
                            <input type="number" class="form-control" name="IsbnBuscado" placeholder="Buscar por ISBN" required />
                            <button type="submit" class="btn btn-secondary">Buscar</button>
                        </div>
                    </form>

                    @if (Model.LibroEncontrado != null)
                    {
                        <div class="alert alert-success shadow-sm">
                            <p class="mb-0"><strong>ISBN:</strong> @Model.LibroEncontrado.Isbn | <strong>Título:</strong> @Model.LibroEncontrado.Titulo | <strong>Autor:</strong> @Model.LibroEncontrado.Autor</p>
                        </div>
                    }

                    <form method="post" asp-page-handler="MenorMayorIsbn" class="d-grid gap-2 mt-3">
                        <button type="submit" name="accion" value="menor" class="btn btn-outline-info text-dark fw-semibold">Mostrar Menor ISBN</button>
                        <button type="submit" name="accion" value="mayor" class="btn btn-outline-warning text-dark fw-semibold">Mostrar Mayor ISBN</button>
                    </form>

                    @if (!string.IsNullOrEmpty(Model.ResultadoExtremo))
                    {
                        <div class="alert alert-secondary mt-3 shadow-sm">@Model.ResultadoExtremo</div>
                    }
                </div>
            </div>
        </div>

        <!-- SECCIÓN 4: REPORTES GRÁFICOS (GRAPHVIZ) -->
        <div class="tab-pane fade" id="reportSection" role="tabpanel">
            <h3 class="mb-3">Reporte Gráfico: Jerarquía de Categorías</h3>
            <p class="text-muted">Visualización n-aria de las categorías y subcategorías cargadas en el sistema.</p>
            @if (!string.IsNullOrEmpty(Model.RutaImagenCategorias))
            {
                <div class="text-center p-3 border bg-light rounded mt-3">
                    <div class="overflow-auto bg-white p-2 border rounded">
                        <img src="@Model.RutaImagenCategorias" class="img-fluid" alt="Árbol de Categorías" />
                    </div>
                </div>
            }
            else
            {
                <p class="text-warning">Cargue un archivo XML con categorías para generar el reporte gráfico.</p>
            }
        </div>

        <!-- SECCIÓN 5: AYUDA -->
        <div class="tab-pane fade" id="helpSection" role="tabpanel">
            <h3 class="mb-3">Información Académica</h3>
            <hr />
            <p class="fs-5"><strong>Curso:</strong> Introducción a la Programación y Computación 2</p>
            <p class="fs-5"><strong>Universidad:</strong> Universidad de San Carlos de Guatemala (USAC)</p>
            <p class="fs-5"><strong>Facultad:</strong> Ingeniería - Escuela de Ciencias y Sistemas</p>
        </div>

    </div>
</div>