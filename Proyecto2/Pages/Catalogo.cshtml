@page
@model Proyecto2.Pages.CatalogoModel
@{
    ViewData["Title"] = "Gestión de Catálogo - USAC";
}

<div class="container mt-4">
    <div class="p-4 mb-4 bg-light rounded-3 shadow-sm">
        <h1 class="display-6 fw-bold">Sistema Inteligente de Librería - USAC</h1>
        <p class="col-md-8 fs-6 text-muted">Gestión de estructuras dinámicas (TDAs propios, Árboles AVL e integración con Graphviz).</p>
    </div>

    <!-- Alertas de Mensajes del Sistema -->
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Menú de Pestañas con todas las opciones del enunciado -->
    <ul class="nav nav-tabs" id="catalogTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="xml-tab" data-bs-toggle="tab" data-bs-target="#xmlSection" type="button" role="tab">1. Cargar XML</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="cat-tab" data-bs-toggle="tab" data-bs-target="#catSection" type="button" role="tab">2. Categorías y Árboles AVL</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="lib-tab" data-bs-toggle="tab" data-bs-target="#libSection" type="button" role="tab">3. Gestión de Libros</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="help-tab" data-bs-toggle="tab" data-bs-target="#helpSection" type="button" role="tab">4. Ayuda</button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-4 bg-white shadow-sm rounded-bottom mb-5" id="catalogTabsContent">
        
        <!-- SECCIÓN 1: CARGA DE XML INCREMENTAL -->
        <div class="tab-pane fade show active" id="xmlSection" role="tabpanel">
            <h3 class="mb-3">Carga de Archivo XML</h3>
            <p class="text-muted">Cargue el archivo XML de configuración inicial o incremental para alimentar las estructuras de categorías y libros en memoria.</p>
            <form method="post" enctype="multipart/form-data" asp-page-handler="CargarXml" class="mt-3">
                <div class="input-group mb-3">
                    <input type="file" class="form-control" name="ArchivoXml" accept=".xml" required />
                    <button type="submit" class="btn btn-primary px-4">Procesar Archivo XML</button>
                </div>
            </form>
        </div>

        <!-- SECCIÓN 2: GESTIÓN DE CATEGORÍAS Y ÁRBOLES AVL -->
        <div class="tab-pane fade" id="catSection" role="tabpanel">
            <h3 class="mb-3">Gestión de Categorías y Jerarquías</h3>
            <form method="post" asp-page-handler="AgregarCategoria" class="row g-3 mb-4 p-3 border rounded bg-light">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Nombre de la Categoría</label>
                    <input type="text" class="form-control" name="NuevaCategoria" placeholder="Ej. Ingeniería" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Categoría Padre (Opcional)</label>
                    <input type="text" class="form-control" name="CategoriaPadre" placeholder="Dejar en blanco si es principal" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Crear</button>
                </div>
            </form>

            <hr class="my-4" />

            <h3 class="mb-3">Visualización Gráfica del Árbol AVL</h3>
            <p class="text-muted">Ingrese el nombre de una categoría existente para generar y renderizar su Árbol AVL ordenado por ISBN mediante Graphviz.</p>
            <form method="get" class="row g-3 mb-4">
                <div class="col-md-9">
                    <input type="text" class="form-control" name="CategoriaSeleccionada" value="@Model.CategoriaSeleccionada" placeholder="Nombre exacto de la categoría" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-dark w-100">Generar Gráfico</button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.RutaImagenAvl))
            {
                <div class="text-center p-3 border bg-light rounded mt-3">
                    <h5 class="text-secondary">Estructura Árbol AVL (ISBN de 6 dígitos)</h5>
                    <div class="overflow-auto bg-white p-2 border rounded">
                        <img src="@Model.RutaImagenAvl" class="img-fluid" alt="Gráfico Árbol AVL" />
                    </div>
                </div>
            }
        </div>

        <!-- SECCIÓN 3: GESTIÓN Y CONSULTAS DE LIBROS -->
        <div class="tab-pane fade" id="libSection" role="tabpanel">
            <div class="row">
                <!-- Registro Individual de Libros -->
                <div class="col-md-6 border-end pe-4">
                    <h3 class="mb-3">Registrar Libro</h3>
                    <form method="post" asp-page-handler="RegistrarLibro">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">ISBN (6 dígitos)</label>
                            <input type="number" class="form-control" name="Isbn" min="100000" max="999999" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Título del Libro</label>
                            <input type="text" class="form-control" name="Titulo" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Autor</label>
                            <input type="text" class="form-control" name="Autor" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Categoría Asociada</label>
                            <input type="text" class="form-control" name="CategoriaNombre" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Registrar Libro en Árbol</button>
                    </form>
                </div>

                <!-- Consultas Avanzadas y Búsquedas -->
                <div class="col-md-6 ps-4">
                    <h3 class="mb-3">Consultas de Libros</h3>
                    
                    <!-- Búsqueda por ISBN -->
                    <form method="post" asp-page-handler="BuscarIsbn" class="mb-4">
                        <label class="form-label fw-semibold">Buscar por ISBN</label>
                        <div class="input-group">
                            <input type="number" class="form-control" name="IsbnBuscado" placeholder="Ej. 100452" required />
                            <button type="submit" class="btn btn-secondary">Buscar</button>
                        </div>
                    </form>

                    @if (Model.LibroEncontrado != null)
                    {
                        <div class="alert alert-success shadow-sm">
                            <h6 class="alert-heading fw-bold">¡Libro Encontrado!</h6>
                            <hr class="my-1">
                            <p class="mb-0"><strong>ISBN:</strong> @Model.LibroEncontrado.Isbn</p>
                            <p class="mb-0"><strong>Título:</strong> @Model.LibroEncontrado.Titulo</p>
                            <p class="mb-0"><strong>Autor:</strong> @Model.LibroEncontrado.Autor</p>
                        </div>
                    }

                    <!-- Consultas de Extremos (Menor y Mayor ISBN) -->
                    <div class="card bg-light border-0 p-3 mt-4">
                        <h6 class="fw-bold mb-3">Consultas de Rango Global</h6>
                        <form method="post" asp-page-handler="MenorMayorIsbn" class="d-grid gap-2">
                            <button type="submit" name="accion" value="menor" class="btn btn-outline-info text-dark fw-semibold">Mostrar Libro con Menor ISBN</button>
                            <button type="submit" name="accion" value="mayor" class="btn btn-outline-warning text-dark fw-semibold">Mostrar Libro con Mayor ISBN</button>
                        </form>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ResultadoExtremo))
                    {
                        <div class="alert alert-secondary mt-3 shadow-sm">
                            @Model.ResultadoExtremo
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SECCIÓN 4: AYUDA E INFORMACIÓN ACADÉMICA -->
        <div class="tab-pane fade" id="helpSection" role="tabpanel">
            <h3 class="mb-3">Información Académica y Documentación</h3>
            <hr />
            <div class="row">
                <div class="col-md-6">
                    <p class="fs-5"><strong>Curso:</strong> Introducción a la Programación y Computación 2</p>
                    <p class="fs-5"><strong>Universidad:</strong> Universidad de San Carlos de Guatemala (USAC)</p>
                    <p class="fs-5"><strong>Facultad:</strong> Ingeniería - Escuela de Ciencias y Sistemas</p>
                </div>
                <div class="col-md-6 border-start ps-4">
                    <h5 class="fw-bold">Especificaciones del Sistema</h5>
                    <p class="text-muted">Desarrollado con arquitectura limpia en ASP.NET Core Razor Pages, implementando algoritmos de balanceo AVL, punteros dinámicos sin librerías estándar de colecciones, y compilación gráfica en tiempo de ejecución mediante Graphviz.</p>
                </div>
            </div>
        </div>

    </div>
</div>